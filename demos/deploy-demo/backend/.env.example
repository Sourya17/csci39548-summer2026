# Set these in Render's dashboard. Local dev: copy to .env (gitignored).

# Neon pooled connection string.
DATABASE_URL=

# Allowed CORS origin. Locally: http://localhost:5173
# On Render: your exact Vercel URL, no trailing slash, e.g. https://your-app.vercel.app
FRONTEND_ORIGIN=

# Render assigns PORT automatically. Do NOT set this in Render's UI.
# PORT=3000
